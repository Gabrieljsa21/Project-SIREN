# Todas as variáveis abaixo são opcionais - sem elas o SIREN sobe normalmente
# e funciona standalone (ver PLANO_SIREN.md, seção 2). O Caos/recomendação só
# fica disponível se o ECHO estiver acessível na URL abaixo.

# URL local do Project ECHO (porta padrão 8774) - mesmo padrão de
# `assistant/integrations/echo_client.py`.
ECHO_URL=http://127.0.0.1:8774

# Arquivo de cookies do YouTube (Netscape format) pro yt-dlp, se faixas
# restritas por idade/região começarem a falhar na resolução - mesmo padrão
# de `Project-ERIS/eris/core/musica.py`.
YOUTUBE_COOKIES_FILE=
